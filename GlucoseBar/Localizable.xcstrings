    "- Try turning Dexcom Share off in the Dexcom G6 or G7 app, force close the app, and then enabling it again." : {
      "comment" : "A suggestion to try resetting the Dexcom Share connection in the app.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Prøv at slå Dexcom Del fra i Dexcom G6 eller G7 appen, luk appen, og derefter aktivere det igen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Essayez de désactiver Dexcom Share dans l'application Dexcom G6 ou G7, forcez la fermeture de l'application, puis réactivez-la."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "- Try turning Dexcom Share off in the Dexcom G6 or G7 app, force close the app, and then enabling it again."
          }
        }
      }
    },
    "- Verify that your Dexcom app isn't logged out or not uploading to Dexcom." : {
      "comment" : "A suggestion to check if the user's Dexcom app is logged out or not uploading data.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Kontroller, at din Dexcom app ikke er logget ud eller ikke uploader til Dexcom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Vérifiez que votre application Dexcom n'est pas déconnectée ou ne téléverse pas sur Dexcom."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "- Verify that your Dexcom app isn't logged out or not uploading to Dexcom."
          }
        }
      }
    },
    "- You are logged into GlucoseBar with the same user as in your primary Dexcom app." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Du er logget ind på GlucoseBar med samme bruger som i din primære Dexcom app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Vous êtes connecté à GlucoseBar avec le même utilisateur que dans votre application Dexcom principale."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "- You are logged into GlucoseBar with the same user as in your primary Dexcom app."
          }
        }
      }
    },
