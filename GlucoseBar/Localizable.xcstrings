    },
    " (If you've gotten this error a few times in a row, this could also mean that the Dexcom servers have given you a short timeout before you can login again)" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (Hvis du har fået denne fejl et par gange i træk, kan det også betyde, at Dexcoms servere har givet dig en kort timeout, før du kan logge ind igen)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (If you've gotten this error a few times in a row, this could also mean that the Dexcom servers have given you a short timeout before you can login again)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (Si has cometido este error varias veces seguidas, esto también podría significar que los servidores de Dexcom le han dado un corto tiempo de espera antes de que pueda iniciar sesión de nuevo)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (Si vous avez reçu cette erreur plusieurs fois de suite, cela pourrait également signifier que les serveurs Dexcom vous ont imposé un court délai avant que vous puissiez vous reconnecter)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (Se hai ottenuto questo errore alcune volte di fila, questo potrebbe anche significare che i server Dexcom vi hanno dato un breve periodo di tempo prima di poter effettuare nuovamente il login)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (Als je deze fout een paar keer achter elkaar hebt geplaatst, Dit kan ook betekenen dat de Dexcom servers u een korte time-out hebben gegeven voordat u weer kunt inloggen)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (Jeśli masz ten błąd kilka razy z rzędu, może to również oznaczać, że serwery Dexcom nadały Ci krótki czas zanim będziesz mógł zalogować się ponownie)"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (Dacă ați primit această eroare de câteva ori la rând, aceasta ar putea însemna că serverele Dexcom ți-au oferit o scurtă perioadă de timp înainte de a te putea conecta din nou)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (Om du har fått detta fel några gånger i rad, detta kan också innebära att Dexcom-servrarna har gett dig en kort tidsgräns innan du kan logga in igen)"
          }
        }
      }
    },
    " No data" : {
