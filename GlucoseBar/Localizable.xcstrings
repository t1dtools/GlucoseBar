    "- Try turning Dexcom Share off in the Dexcom G6 or G7 app, force close the app, and then enabling it again." : {
      "comment" : "A suggestion to try resetting the Dexcom Share connection in the app.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Prøv at slå Dexcom Del fra i Dexcom G6 eller G7 appen, luk appen, og derefter aktivere det igen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Intente desactivar Dexcom Share en la aplicación Dexcom G6 o G7, cierre la aplicación y vuelva a activarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Essayez de désactiver Dexcom Share dans l'application Dexcom G6 ou G7, forcez la fermeture de l'application, puis réactivez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Provare a trasformare Dexcom Share off nell'app Dexcom G6 o G7, forzare la chiusura dell'app e poi riabilitarla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Probeer Dexcom Share uit te zetten in de Dexcom G6 of G7 app, de app gedwongen te sluiten en vervolgens opnieuw in te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Spróbuj wyłączyć udział Dexcom w aplikacji Dexcom G6 lub G7, wymuś zamknięcie aplikacji, a następnie włączyć ją ponownie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Încercați să dezactivați opțiunea Dexcom Share în aplicația Dexcom G6 sau G7, să închideți aplicația și apoi să o activați din nou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Försök att stänga av Dexcom Dela av i Dexcom G6 eller G7-appen, tvinga appen att stänga och aktivera den igen."
          }
        }
      }
    },
    "- Verify that your Dexcom app isn't logged out or not uploading to Dexcom." : {
      "comment" : "A suggestion to check if the user's Dexcom app is logged out or not uploading data.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Kontroller, at din Dexcom app ikke er logget ud eller ikke uploader til Dexcom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Verifique que su aplicación Dexcom no haya cerrado la sesión o no haya subido a Dexcom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Vérifiez que votre application Dexcom n'est pas déconnectée ou ne téléverse pas sur Dexcom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Verificare che l'app Dexcom non sia disconnessa o non sia caricata su Dexcom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Controleer of uw Dexcom app niet is uitgelogd of niet is geüpload naar Dexcom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Sprawdź, czy aplikacja Dexcom nie została wylogowana lub nie została przesłana do Dexcom."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Verifică dacă aplicația ta Dexcom nu este deconectată sau nu se încarcă pe Dexcom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Kontrollera att din Dexcom-app inte är utloggad eller inte laddas upp till Dexcom."
          }
        }
      }
    },
    "- You are logged into GlucoseBar with the same user as in your primary Dexcom app." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Du er logget ind på GlucoseBar med samme bruger som i din primære Dexcom app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Ha iniciado sesión en GlucoseBar con el mismo usuario que en su aplicación principal de Dexcom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Vous êtes connecté à GlucoseBar avec le même utilisateur que dans votre application Dexcom principale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Sei connesso a GlucoseBar con lo stesso utente della tua app Dexcom primaria."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- U bent aangemeld bij GlucoseBar met dezelfde gebruiker als in uw primaire Dexcom app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Jesteś zalogowany do GlucoseBar z tym samym użytkownikiem, co w głównej aplikacji Dexcom."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Ești conectat în GlucoseBar cu același utilizator ca în aplicația ta primară Dexcom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Du är inloggad i GlucoseBar med samma användare som i din primära Dexcom-app."
          }
        }
      }
    },
    "- You have enabled Dexcom Share and have at least one follower." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Du har aktiveret Dexcom Share og har mindst én følger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Has habilitado Dexcom Share y tienes al menos un seguidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Vous avez activé Dexcom Share et avez au moins un abonné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Hai abilitato Dexcom Share e hai almeno un follower."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- U heeft Dexcom Share ingeschakeld en heeft ten minste één volger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Włączyłeś Dexcom Share i masz co najmniej jednego obserwatora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Ați activat Partajarea Dexcom și aveți cel puțin un urmăritor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Du har aktiverat Dexcom Share och har minst en följare."
          }
        }
      }
    },
