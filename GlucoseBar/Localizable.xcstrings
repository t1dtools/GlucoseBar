    "Removes all saved settings and returns the app to its initial state, while keeping Debug Mode enabled." : {
      "comment" : "A description of what resetting all data will do.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner alle gemte indstillinger og nulstiller appen, samtidig med at Fejlsøgningstilstand beholdes aktiveret."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todos los ajustes guardados y devuelve la aplicación a su estado inicial, manteniendo habilitado el modo de depuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tous les paramètres enregistrés et renvoie l'application à son état initial, tout en gardant le mode débogage activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove tutte le impostazioni salvate e restituisce l'applicazione al suo stato iniziale, mantenendo la modalità di debug abilitata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert alle opgeslagen instellingen en keert de app terug naar zijn oorspronkelijke staat, terwijl Debug Mode ingeschakeld blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa wszystkie zapisane ustawienia i zwraca aplikację do stanu początkowego, przy czym tryb debugowania jest włączony."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimină toate setările salvate și returnează aplicația la starea sa inițială, păstrând modul de depanare activat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort alla sparade inställningar och returnerar appen till sitt ursprungliga tillstånd, samtidigt som felsökningsläget är aktiverat."
          }
        }
      }
    },
    "Removes the debug menu from the settings panel and stops writing logs to disk for each session. Recommended if you are not a developer or helping a developer understand a problem." : {
      "comment" : "A description of the functionality of disabling Debug Mode.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner fejlfindingsmenuen fra indstillingspanelet og stopper med at skrive logfiler til disk for hver session. Anbefales, hvis du ikke er udvikler eller hjælper en udvikler med at forstå et problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina el menú de depuración del panel de configuración y deja de escribir registros en el disco para cada sesión. Recomendado si no eres un desarrollador o ayudas a un desarrollador a entender un problema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime le menu de débogage du panneau des paramètres et arrête l'écriture des journaux sur disque pour chaque session. Recommandé si vous n'êtes pas un développeur ou si vous aidez un développeur à comprendre un problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove il menu di debug dal pannello delle impostazioni e smette di scrivere log su disco per ogni sessione. Consigliato se non sei uno sviluppatore o aiutando uno sviluppatore a capire un problema."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert het debug menu uit het instellingenpaneel en stopt met het naar schijf schrijven van logs voor elke sessie. Aanbevolen als u geen ontwikkelaar bent of een ontwikkelaar helpt een probleem te begrijpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa menu debugowania z panelu ustawień i zatrzymuje zapisywanie dzienników na dysku dla każdej sesji. Zalecane jeśli nie jesteś deweloperem lub nie pomagasz deweloperowi zrozumieć problemu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimină meniul de depanare din panoul de setări și oprește scrierea jurnalelor de pe disc pentru fiecare sesiune. Recomandat dacă nu sunteţi un dezvoltator sau dacă ajutaţi un dezvoltator să înţeleagă o problemă."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort felsökningsmenyn från inställningspanelen och slutar skriva loggar till disk för varje session. Rekommenderas om du inte är en utvecklare eller hjälper en utvecklare att förstå ett problem."
          }
        }
      }
    },
    "Replaces your configured items in the menu bar with a circle that changes color based on glucose levels." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstatter dine indstillede punkter i menulinjen med en cirkel, der ændrer farve baseret på glukoseniveauer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaces your configured items in the menu bar with a circle that changes color based on glucose levels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplaza los elementos configurados en la barra de menú por un círculo que cambia de color basado en niveles de glucosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace vos éléments configurés dans la barre des menus par un cercle qui change de couleur en fonction des valeurs de glycémie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce gli elementi configurati nella barra dei menu con un cerchio che cambia colore in base ai livelli di glucosio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervangt de ingestelde items in de menubalk door een cirkel die van kleur verandert op basis van glucosewaarden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastępuje skonfigurowane elementy na pasku menu okręgem, który zmienia kolor w zależności od poziomu glukozy."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înlocuiește elementele configurate în bara de meniu cu un cerc care schimbă culoarea în funcție de nivelurile de glucoză."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersätter dina konfigurerade objekt i menyraden med en cirkel som ändrar färg baserad på glukosnivåer."
          }
        }
      }
    },
    "Request timed out" : {
      "localizations" : {
        "da" : {
