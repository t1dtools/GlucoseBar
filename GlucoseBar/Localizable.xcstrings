    "We are always looking for help with ideas, bugfixes and translations. If you want to contribute, please see the GitHub respository." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi er altid på udkig efter hjælp med ideer, fejlrettelser og oversættelser. Hvis du ønsker at bidrage, så slå et smut forbi GitHub."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We are always looking for help with ideas, bugfixes and translations. If you want to contribute, please see the GitHub respository."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre estamos buscando ayuda con ideas, correcciones de errores y traducciones. Si quieres contribuir, consulta el repositorio de GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous recherchons toujours de l'aide avec des idées, des corrections de bogues et des localisations. Si vous voulez contribuer, veuillez consulter le référentiel GitHub."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siamo sempre alla ricerca di aiuto con idee, correzioni di bug e traduzioni. Se vuoi contribuire, consulta il respositorio GitHub."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We zijn altijd op zoek naar hulp met ideeën, bugfixes en vertalingen. Als u wilt bijdragen, zie dan de GitHub respository."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawsze szukamy pomocy z pomysłami, poprawkami błędów i tłumaczeniami. Jeśli chcesz pomóc, zobacz repozytorium GitHub."
