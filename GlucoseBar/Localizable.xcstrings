    "Since this is the first time we meet, you need to help me access your Glucose data. Head over to %@ Settings to get started." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da dette er første gang, vi mødes, har jeg brug for hjælp med at få adgang til dine glukosedata. Gå over til %@ Indstillinger for at komme i gang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since this is the first time we meet, you need to help me access your Glucose data. Head over to %@ Settings to get started."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dado que esta es la primera vez que nos reunimos, necesitas ayudarme a acceder a tus datos de Glucosa. Dirígete a Ajustes %@ para empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puisque c'est la première fois que nous rencontrons, vous devez m'aider à accéder à vos données de glycémie. Rendez-vous dans les paramètres de %@ pour commencer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poiché questa è la prima volta che ci incontriamo, devi aiutarmi ad accedere ai tuoi dati Glucosio. Vai alle impostazioni di %@ per iniziare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangezien dit de eerste keer is dat we elkaar ontmoeten, moet u mij helpen om toegang te krijgen tot uw glucosegegevens. Ga naar %@ Instellingen om aan de slag te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponieważ spotkaliśmy się po raz pierwszy, musisz pomóc mi uzyskać dostęp do danych Glukozy. Przejdź do %@ Ustawienia, aby rozpocząć."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deoarece este prima dată când ne întâlnim trebuie să mă ajuți să accesez datele dvs. despre glucoză. Mergi la Setările %@ pentru a începe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eftersom detta är första gången vi träffas, måste du hjälpa mig att komma åt dina glukosdata. Gå över till %@ inställningar för att komma igång."
          }
        }
      }
    },
