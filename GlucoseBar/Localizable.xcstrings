      }
    },
    "This will delete all settings, and restart the application. This cannot be undone." : {
      "comment" : "A confirmation dialog message for the reset data action.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil slette alle indstillinger og genstarte programmet. Dette kan ikke fortrydes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará todos los ajustes y reiniciará la aplicación. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera tous les paramètres, et redémarrera l'application. C’est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo eliminerà tutte le impostazioni e riavvierà l'applicazione. Questo non può essere annullato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit zal alle instellingen verwijderen en de applicatie opnieuw starten. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie wszystkich ustawień i ponowne uruchomienie aplikacji. Tej operacji nie można cofnąć."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta va șterge toate setările și va reporni aplicația. Această acțiune nu poate fi anulată."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta kommer att ta bort alla inställningar och starta om programmet. Detta kan inte ångras."
          }
        }
      }
    },
    "This will disable Debug Mode which will stop GlucoseBar writing log files to your computer and remove the Debug menu from the settings panel." : {
      "comment" : "A message displayed in a confirmation dialog within the `DebugSettingsView`. Asks the user if they are sure they want to disable Debug Mode.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil deaktivere fejlsøgningstilstand, som vil stoppe GlucoseBar i at skrive logfiler til din computer og fjerne fejlfindingsmenuen fra indstillingspanelet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto desactivará el modo de depuración que detendrá GlucoseBar escribiendo archivos de registro en su computadora y eliminará el menú de depuración del panel de ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela désactivera le mode débogage qui empêchera GlucoseBar d'écrire des journaux sur votre ordinateur et supprimera le menu de débogage du panneau des paramètres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo disabiliterà la modalità Debug che impedirà la scrittura di file di log di GlucoseBar sul computer e rimuoverà il menu Debug dal pannello delle impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit zal debug-modus uitschakelen die GlucoseBar schrijflogbestanden naar je computer zal stoppen en het Debug menu uit het instellingenpaneel zal verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to wyłączenie trybu debugowania, który zatrzyma zapisywanie plików dziennika GlucoseBar na komputer i usunie menu debugowania z panelu ustawień."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest lucru va dezactiva Modul de depanare care va opri scrierea de fișiere de jurnal pe computer și va elimina meniul de depanare din panoul de setări."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta kommer att inaktivera felsökningsläge som kommer att stoppa GlucoseBar skriva loggfiler till din dator och ta bort Debug-menyn från inställningspanelen."
          }
        }
      }
    },
