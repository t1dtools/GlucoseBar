        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki dzienników są przechowywane w ~/Library/Aplikacja Support/tools.t1d.GlucoseBar/logs/. Każda sesja tworzy nowy debug.log; poprzednia sesja zostanie zmieniona za pomocą znacznika czasowego."
