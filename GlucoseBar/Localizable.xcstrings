          }
        }
      }
    },
    "These credentials are the ones from your primary Dexcom account. You must also have at least one follower in the Dexcom app." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse legitimationsoplysninger er dem fra din primære Dexcom konto. Du skal også have mindst én følger i Dexcom appen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These credentials are the ones from your primary Dexcom account. You must also have at least one follower in the Dexcom app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas credenciales son las de tu cuenta principal de Dexcom. También debes tener al menos un seguidor en la aplicación de Dexcom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces identifiants sont ceux de votre compte Dexcom principal. Vous devez également avoir au moins un abonné dans l'application Dexcom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste credenziali sono quelle del tuo conto Dexcom primario. Devi anche avere almeno un follower nell'app Dexcom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze referenties zijn de gegevens van uw primaire Dexcom account. U moet ten minste één volger in de Dexcom app hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te dane uwierzytelniające są danymi z Twojego głównego konta Dexcom. Musisz również mieć co najmniej jednego obserwującego w aplikacji Dexcom."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceste credențiale sunt cele din contul tău Dexcom principal. De asemenea, trebuie să ai cel puțin un adept în aplicația Dexcom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa uppgifter är de från ditt primära Dexcom-konto. Du måste också ha minst en följare i Dexcom-appen."
          }
        }
      }
    },
    "This is the data you see in and around the chart when you open GlucoseBar" : {
