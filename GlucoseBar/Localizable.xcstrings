    "Show Loop Status" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis Loop Status"
          }
        }
      }
    },
    "Since this is the first time we meet, you need to help me access your Glucose data. Head over to %@ Settings to get started." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da dette er første gang, vi mødes, har jeg brug for hjælp med at få adgang til dine glukosedata. Gå over til %@ Indstillinger for at komme i gang."
          }
        }
      }
    },
